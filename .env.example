# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=
DATE_COLUMN=

# App auth
APP_PASSWORD_HASH=
SESSION_SECRET=

# Cron auth
CRON_SECRET=

# Upstash Redis (se retira al completar la migración a Postgres — SB-11)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Postgres (Supabase) — ADR 0006. Local (supabase start):
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Opcional: presupuesto de tiempo (ms) por invocación del full sync.
# Sin definir = la invocación corre hasta terminar (uso local / Vercel Pro).
# En plataformas con timeout corto (p. ej. Vercel Hobby 60s), un valor tipo
# 40000 hace que cada llamada corte a tiempo con checkpoint y responda done:false
# para que el cliente encadene la siguiente.
# SYNC_BUDGET_MS=
