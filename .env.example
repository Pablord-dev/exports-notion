# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=
DATE_COLUMN=

# App auth
APP_PASSWORD_HASH=
SESSION_SECRET=

# Cron auth
CRON_SECRET=

# Postgres (Supabase) — ADR 0006.
#   Local (supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   Cloud/serverless: usar el TRANSACTION POOLER (puerto 6543), NO el directo (5432):
#     postgresql://postgres.<ref>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres
#   Copiarlo del dashboard (botón Connect → Transaction pooler); el host varía por región.
#   db.ts pasa prepare:false porque pgBouncer en modo transaction no soporta
#   prepared statements (el default de postgres.js).
DATABASE_URL=

# Presupuesto de tiempo (ms) por invocación del full sync.
# Sin definir = la invocación corre hasta terminar (uso local / Vercel Pro).
# OBLIGATORIO en Vercel Hobby (cap de 60s): 40000 hace que cada llamada corte a
# tiempo con checkpoint y responda done:false; la UI encadena hasta 20 llamadas.
# El cron full NO encadena — en Hobby el full se corre a mano desde la UI.
# SYNC_BUDGET_MS=40000

# --- Asistente IA (todas opcionales; sin ellas el chat muestra "sin modelo") ---
# Ollama local — NO funciona en la nube (localhost no existe en serverless).
# LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_OLLAMA_MODEL=
# MiniMax — el proveedor para deploy. Requiere las TRES vars o no se registra.
# LLM_MINIMAX_BASE_URL=
# LLM_MINIMAX_API_KEY=
# LLM_MINIMAX_MODEL=
# LLM_DEFAULT_PROVIDER=minimax
